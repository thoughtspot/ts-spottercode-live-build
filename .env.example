# ─── Shared ThoughtSpot connection ────────────────────────────────────────────
# Copy this file to .env.local at the repo root and fill in the values:
#   cp .env.example .env.local
# Next.js loads .env.local automatically. It is gitignored, so never commit it.

# Public URL of your ThoughtSpot instance (a trailing slash is fine)
NEXT_PUBLIC_THOUGHTSPOT_HOST=https://your.thoughtspot.cloud

# Trusted Auth secret key — server-side only, never prefix with NEXT_PUBLIC_
THOUGHTSPOT_SECRET_KEY=developer-secret-key-here